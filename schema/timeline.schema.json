{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smart-terrarium:schema:timeline:v1",
  "title": "Timeline",
  "description": "サーバーが生成し、デバイスが決定論的に再生する演出タイムライン",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "source", "speed", "loop", "frames"],
  "properties": {
    "version": { "const": 1 },
    "id": {
      "description": "サーバーが発行する識別子。デバイスは status でこの値をそのまま返す",
      "type": "string",
      "minLength": 1
    },
    "source": {
      "description": "再現する実在の場所と期間",
      "type": "object",
      "additionalProperties": false,
      "required": ["place", "lat", "lon", "tz", "start", "end"],
      "properties": {
        "place": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "tz": {
          "description": "IANA タイムゾーン名（例: Asia/Tokyo）",
          "type": "string",
          "minLength": 1
        },
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "speed": {
      "description": "実時間に対する再生倍率",
      "type": "number",
      "minimum": 1
    },
    "loop": { "type": "boolean" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "colorComponent": { "type": "integer", "minimum": 0, "maximum": 255 },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t"],
      "properties": {
        "t": {
          "description": "source.start からの経過秒",
          "type": "integer",
          "minimum": 0
        },
        "sky": {
          "description": "空の色 [r, g, b]",
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/colorComponent" },
            { "$ref": "#/$defs/colorComponent" },
            { "$ref": "#/$defs/colorComponent" }
          ],
          "items": false,
          "minItems": 3
        },
        "bri": { "$ref": "#/$defs/percent" },
        "sun": { "$ref": "#/$defs/percent" },
        "mist": { "$ref": "#/$defs/percent" },
        "rain": { "$ref": "#/$defs/percent" },
        "event": { "enum": ["sunrise", "sunset", "lightning"] }
      }
    }
  }
}
